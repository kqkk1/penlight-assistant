{
  "manifest_version": 3,
  "name": "Penlight Assistant for MIX PENLa PRO-361",
  "version": "4.6.3",
  "description": "MIX PENLa PRO-361のWeb設定ツールを快適にする入力アシスト拡張機能",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://penlight-supporter.onrender.com/setlist*"
      ],
      "js": [
        "config.js",
        "utils.js",
        "grouper.js",
        "data.js",
        "site.js",
        "styles.js",
        "ui.js",
        "main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
